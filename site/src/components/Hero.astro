---
interface Props {
  hero: {
    eyebrow: string;
    title: string;
    copy: string;
    ctaExplore: string;
    ctaGitHub: string;
    meta: string;
    install: string;
    workflow: {
      humanTop: { label: string; desc: string };
      discover: { label: string; desc: string };
      plan: { label: string; desc: string };
      build: { label: string; desc: string };
      review: { label: string; desc: string };
      humanBottom: { label: string; desc: string };
      status: string;
      statusNote: string;
    };
  };
}

const { hero } = Astro.props;
const titleParts = hero.title.split("<em>");
const titleBefore = titleParts[0];
const titleEm = titleParts[1]?.replace("</em>", "") ?? "";
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1>{titleBefore}<em>{titleEm}</em></h1>
      <p class="hero-copy">{hero.copy}</p>
      <div class="hero-actions">
        <a class="button primary" href="#loop">{hero.ctaExplore}</a>
        <a class="button" href="https://github.com/nitdraig/lexis-two" target="_blank" rel="noreferrer">{hero.ctaGitHub}</a>
      </div>
      <div class="install-line">
        <span class="prompt">$</span>
        <code>{hero.install}</code>
      </div>
      <div class="hero-meta" style="margin-top: 0.75rem;">{hero.meta}</div>
    </div>

    <div class="workflow" aria-label="Lexis workflow">
      <div class="workflow-grid">
        <div class="node human">
          <strong>{hero.workflow.humanTop.label}</strong>
          <span>{hero.workflow.humanTop.desc}</span>
        </div>
        <div class="node">
          <strong>{hero.workflow.discover.label}</strong>
          <span>{hero.workflow.discover.desc}</span>
        </div>
        <div class="node">
          <strong>{hero.workflow.plan.label}</strong>
          <span>{hero.workflow.plan.desc}</span>
        </div>
        <div class="node">
          <strong>{hero.workflow.build.label}</strong>
          <span>{hero.workflow.build.desc}</span>
        </div>
        <div class="node">
          <strong>{hero.workflow.review.label}</strong>
          <span>{hero.workflow.review.desc}</span>
        </div>
        <div class="node human">
          <strong>{hero.workflow.humanBottom.label}</strong>
          <span>{hero.workflow.humanBottom.desc}</span>
        </div>
      </div>
      <div class="workflow-status">
        <span><span class="pulse"></span>{hero.workflow.status}</span>
        <span>{hero.workflow.statusNote}</span>
      </div>
    </div>
  </div>
</section>
