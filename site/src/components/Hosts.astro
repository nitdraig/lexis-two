---
interface Props {
  hosts: {
    eyebrow: string;
    title: string;
    copy: string;
    items: string[];
  };
}

const { hosts } = Astro.props;
---

<section class="section" id="hosts">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">{hosts.eyebrow}</div>
      <h2>{hosts.title}</h2>
      <p>{hosts.copy}</p>
    </div>
    <div class="hosts reveal" aria-label="Supported hosts">
      {hosts.items.map((host) => (
        <div class="host">{host}</div>
      ))}
    </div>
  </div>
</section>
