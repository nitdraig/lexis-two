{
  "name": "@draig/lexis-two",
  "version": "1.5.1",
  "description": "The simple way to obtain the best code. A portable ruleset that steers coding agents: prove the feature, prefer the platform, ship the minimum.",
  "author": "Agustin Avellaneda (https://github.com/nitdraig)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitdraig/lexis-two.git"
  },
  "homepage": "https://lexis-two.excelso.xyz",
  "bugs": {
    "url": "https://github.com/nitdraig/lexis-two/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lexis-two": "scripts/install.js"
  },
  "main": "./.opencode/plugins/lexis-two.mjs",
  "exports": {
    ".": "./.opencode/plugins/lexis-two.mjs",
    "./server": "./.opencode/plugins/lexis-two.mjs",
    "./tui": "./.opencode/plugins/lexis-two-tui.mjs"
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "AGENTS.md",
    "DISCOVERY.md",
    "DESX.md",
    "SPECXIS.md",
    "docs/discovery.md",
    "docs/desx.md",
    "docs/slopx.md",
    "docs/specxis.md",
    "docs/commandcode.md",
    "docs/stacks.md",
    ".cursor/rules/lexis-two.mdc",
    ".windsurf/rules/lexis-two.md",
    ".clinerules/lexis-two.md",
    ".kiro/steering/lexis-two.md",
    ".github/copilot-instructions.md",
    ".github/plugin/",
    ".claude-plugin/",
    "gemini-extension.json",
    ".opencode/plugins/lexis-two.mjs",
    ".opencode/plugins/lexis-two-tui.mjs",
    ".opencode/commands/",
    "commands/",
    "hooks/",
    "skills/",
    "stacks/",
    "templates/",
    "scripts/",
    "pi-extension/index.js",
    "pi-extension/package.json"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "lexis-two"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "node scripts/check-syntax.js",
    "postinstall": "node scripts/opencode-wrapper-postinstall.mjs",
    "lexis-two": "node scripts/install.js",
    "test": "node scripts/check-rule-copies.js && node --test tests/*.test.js && npm test --prefix pi-extension",
    "benchmark:opencode-go": "node benchmarks/benchmark-opencode-go.js --repeat 3 --write-md",
    "benchmark:report": "node benchmarks/render-opencode-go-report.js",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site"
  },
  "pi": {
    "extensions": [
      "./pi-extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
