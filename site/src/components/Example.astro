---
interface Props {
  example: {
    eyebrow: string;
    title: string;
    copy: string;
    withoutTitle: string;
    withoutLines: string;
    withoutCode: string;
    withTitle: string;
    withLines: string;
    withCode: string;
    note: string;
    copyLabel: string;
    copiedLabel: string;
  };
}

const { example } = Astro.props;
---

<section class="section" id="example">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">{example.eyebrow}</div>
      <h2>{example.title}</h2>
      <p>{example.copy}</p>
    </div>

    <div class="code-grid reveal">
      <div class="code-panel">
        <div class="code-head">
          <span>{example.withoutTitle}</span>
          <span class="line-count">{example.withoutLines}</span>
        </div>
        <div class="code-body"><pre class="code-pre" id="withoutCode">{example.withoutCode}</pre></div>
      </div>
      <div class="code-panel">
        <div class="code-head">
          <span class="good">{example.withTitle}</span>
          <span class="line-count">{example.withLines}</span>
        </div>
        <div class="code-body">
          <pre class="code-pre" id="withCodeText">{example.withCode}</pre>
          <button class="copy-btn" id="copyExampleBtn" data-label={example.copyLabel} data-copied={example.copiedLabel}>
            {example.copyLabel}
          </button>
        </div>
      </div>
    </div>
    <p class="code-note reveal">{example.note}</p>
  </div>
</section>

<script>
  (function () {
    var btn = document.getElementById("copyExampleBtn");
    if (!btn) return;
    btn.addEventListener("click", async function () {
      var code = document.getElementById("withCodeText")!.textContent || "";
      try {
        await navigator.clipboard.writeText(code.trim());
        btn.textContent = btn.getAttribute("data-copied");
      } catch {
        btn.textContent = "Select";
      }
      setTimeout(function () {
        btn.textContent = btn.getAttribute("data-label");
      }, 1400);
    });
  })();
</script>
