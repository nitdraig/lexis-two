---
interface Props {
  install: {
    eyebrow: string;
    title: string;
    command: string;
    copy: string;
    copied: string;
    chips: string[];
  };
}

const { install } = Astro.props;
---

<section class="section" id="install">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">{install.eyebrow}</div>
      <h2>{install.title}</h2>
    </div>
    <div class="install-box reveal">
      <code id="installCommand">{install.command}</code>
      <button id="copyInstallBtn" data-label={install.copy} data-copied={install.copied}>{install.copy}</button>
    </div>
    <div class="install-meta reveal">
      {install.chips.map((chip) => (
        <span class="chip">{chip}</span>
      ))}
    </div>
  </div>
</section>

<script>
  (function () {
    var btn = document.getElementById("copyInstallBtn");
    if (!btn) return;
    btn.addEventListener("click", async function () {
      var command = document.getElementById("installCommand")!.textContent || "";
      try {
        await navigator.clipboard.writeText(command.trim());
        btn.textContent = btn.getAttribute("data-copied");
      } catch {
        btn.textContent = "Select";
      }
      setTimeout(function () {
        btn.textContent = btn.getAttribute("data-label");
      }, 1400);
    });
  })();
</script>
