---
import type { Locale } from "../i18n/index.js";
import { getDictionary } from "../i18n/index.js";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Problem from "./Problem.astro";
import Thesis from "./Thesis.astro";
import Loop from "./Loop.astro";
import Checkpoint from "./Checkpoint.astro";
import Agents from "./Agents.astro";
import Principles from "./Principles.astro";
import Ladder from "./Ladder.astro";
import CommandsExplained from "./CommandsExplained.astro";
import Example from "./Example.astro";
import Hosts from "./Hosts.astro";
import BenchmarkStrip from "./BenchmarkStrip.astro";
import Vision from "./Vision.astro";
import Install from "./Install.astro";
import FinalCta from "./FinalCta.astro";
import Footer from "./Footer.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Header locale={locale} nav={t.nav} />

<main id="main">
  <Hero hero={t.home.hero} />
  <Problem problem={t.home.problem} />
  <Thesis thesis={t.home.thesis} />
  <Loop loop={t.home.loop} />
  <Checkpoint checkpoint={t.home.checkpoint} />
  <Agents agents={t.home.agents} />
  <Principles principles={t.home.principles} />
  <Ladder ladder={t.home.ladder} />
  <CommandsExplained commandsExplained={t.home.commandsExplained} />
  <Example example={t.home.example} />
  <Hosts hosts={t.home.hosts} />
  <BenchmarkStrip benchmarks={t.home.benchmarks} />
  <Vision vision={t.home.vision} />
  <Install install={t.home.install} />
  <FinalCta finalCta={t.home.finalCta} />
</main>

<Footer locale={locale} footer={t.footer} />
