---
interface Props {
  agnostic: {
    eyebrow: string;
    title: string;
    copy: string;
    cards: readonly {
      tag: string;
      title: string;
      desc: string;
    }[];
  };
}

const { agnostic } = Astro.props;
---

<section class="section" id="agnostic">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">{agnostic.eyebrow}</div>
      <h2>{agnostic.title}</h2>
      <p>{agnostic.copy}</p>
    </div>
    <div class="agnostic-grid reveal">
      {agnostic.cards.map((card) => (
        <article class="agnostic-card">
          <div class="tag">{card.tag}</div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .agnostic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .agnostic-card {
    min-height: 250px;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .agnostic-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .agnostic-card .tag {
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .agnostic-card h3 {
    margin: 3.5rem 0 0.6rem;
    font-size: 1.5rem;
  }

  .agnostic-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 1020px) {
    .agnostic-grid {
      grid-template-columns: 1fr;
    }
    .agnostic-card {
      min-height: auto;
    }
    .agnostic-card h3 {
      margin-top: 2.5rem;
    }
  }
</style>
