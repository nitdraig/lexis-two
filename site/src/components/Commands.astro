---
interface Props {
  locale: "en" | "es";
  commands: {
    title: string;
    subtitle: string;
    items: readonly {
      name: string;
      desc: string;
    }[];
  };
}

const { locale, commands } = Astro.props;
---

<section id="commands">
  <div class="wrap">
    <div class="section-head">
      <h2>{commands.title}</h2>
      <p>{commands.subtitle}</p>
    </div>
    <div class="cmd-grid">
      {
        commands.items.map((cmd) => (
          <div class="cmd-card">
            <code>{cmd.name}</code>
            <p>{cmd.desc}</p>
          </div>
        ))
      }
    </div>
    <a class="guide-link" href={locale === "es" ? "/es/guide" : "/guide"}>{commands.guideLink}</a>
  </div>
</section>

<style>
  .guide-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-dim);
  }

  .guide-link:hover {
    border-color: var(--accent);
  }
</style>
