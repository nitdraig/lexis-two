---
import "../styles/global.css";
import type { Locale } from "../i18n/index.js";
import { getDictionary } from "../i18n/index.js";

interface Props {
  locale: Locale;
  canonicalPath: string;
  title?: string;
  description?: string;
  extraSchema?: Record<string, unknown>;
}

const { locale, canonicalPath, title, description, extraSchema } = Astro.props;
const t = getDictionary(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

// lexis: simple i18n path mapping — add when locale count exceeds 2
const alternateEn = canonicalPath.startsWith("/es")
  ? canonicalPath.replace(/^\/es/, "") || "/"
  : canonicalPath;
const alternateEs = canonicalPath.startsWith("/es")
  ? canonicalPath
  : `/es${canonicalPath}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lexis-Two",
  description: pageDescription,
  url: `https://lexis-two.excelso.xyz${canonicalPath}`,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Cross-platform",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Person",
    name: "nitdraig",
    url: "https://github.com/nitdraig",
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#090b10" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="nitdraig" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:url"
      content={`https://lexis-two.excelso.xyz${canonicalPath}`}
    />
    <meta
      property="og:image"
      content="https://lexis-two.excelso.xyz/new-logo.png"
    />
    <meta property="og:site_name" content="Lexis-Two" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="twitter:image"
      content="https://lexis-two.excelso.xyz/new-logo.png"
    />

    <!-- Canonical & hreflang -->
    <link
      rel="canonical"
      href={`https://lexis-two.excelso.xyz${canonicalPath}`}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={`https://lexis-two.excelso.xyz${alternateEn}`}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={`https://lexis-two.excelso.xyz${alternateEs}`}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`https://lexis-two.excelso.xyz${alternateEn}`}
    />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    {extraSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(extraSchema)}
      />
    )}

    <link rel="icon" href="/new-logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- lexis: inline theme to prevent FOUC -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("lexis-theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      // lexis: minimal scroll-reveal, no library
      (function () {
        var reveals = document.querySelectorAll(".reveal");
        if (!reveals.length) return;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        reveals.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
